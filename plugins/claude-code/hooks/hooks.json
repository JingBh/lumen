{
  "description": "Lumen: a prompt, each tool call, a turn's end, a wait for the user and a session's end. Lumen reads the rest from the transcript. SessionEnd waits, as Claude Code may be exiting.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/forward.sh", "claude-code"], "timeout": 3 }]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/forward.sh", "claude-code"], "timeout": 3 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/forward.sh", "claude-code"], "async": true }]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [{ "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/forward.sh", "claude-code"], "async": true }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/forward.sh", "claude-code"], "timeout": 2 }]
      }
    ]
  }
}
